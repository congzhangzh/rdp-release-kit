<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The camera extension (@BUNDLE_ID@.camera.systemextension): sandboxed, in the app group
     its CMIOExtensionMachServiceName starts with (<team>.<app id>.camera begins with the group
     and a dot). No hardened-runtime exception (com.apple.security.cs.*): macOS refuses to
     load a system extension that has one. sign-mac.sh adds the application and team
     identifiers for a Developer ID signature. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>@TEAM_ID@.@BUNDLE_ID@</string>
    </array>
</dict>
</plist>
