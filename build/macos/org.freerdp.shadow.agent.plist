<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon mode's agent: launchd runs one at the login window (as root: the input goes
     to the HID system) and one in each user's session (as that user); the daemon
     (org.freerdp.shadow.daemon.plist) uses the one on the console, so a connection lasts from
     the login window through the login to the desktop. Its argument is the daemon's Mach
     service. Screen Recording and Accessibility are granted to this program, not to the
     server. install-daemon.sh copies it to /Library/LaunchAgents/ (root:wheel, 644). -->
<plist version="1.0">
<dict>
    <key>Label</key>              <string>org.freerdp.shadow.agent</string>
    <key>LimitLoadToSessionType</key>
    <array>
        <string>LoginWindow</string>
        <string>Aqua</string>
    </array>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/FreeRDP-Shadow.app/Contents/MacOS/freerdp-shadow-agent</string>
        <string>org.freerdp.shadow</string>
    </array>
    <key>RunAtLoad</key>          <true/>
    <!-- it ends when the daemon is gone; launchd starts it again, at most every 10 s -->
    <key>KeepAlive</key>          <true/>
    <key>ThrottleInterval</key>   <integer>10</integer>
    <key>ProcessType</key>        <string>Interactive</string>
    <!-- one log for every session's agent, appended to (install-daemon.sh makes it writable
         for the agents that run as a user) -->
    <key>StandardOutPath</key>    <string>/var/log/freerdp-shadow/agent.log</string>
    <key>StandardErrorPath</key>  <string>/var/log/freerdp-shadow/agent.log</string>
</dict>
</plist>
