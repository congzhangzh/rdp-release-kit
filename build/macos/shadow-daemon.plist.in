<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon mode's server: FreeRDP's shadow server as a root LaunchDaemon. It keeps the
     clients, TLS, the login (PAM) and the encoder; an agent in the session on the console
     (@BUNDLE_ID@.agent.plist) captures and posts the input for it, over the Mach
     service below (FREERDP_SHADOW_MAC_AGENT_SERVICE names it). install-daemon.sh copies it to
     /Library/LaunchDaemons/ (root:wheel, 644); on 127.0.0.1 only (README.txt: reach it over
     SSH). -->
<plist version="1.0">
<dict>
    <key>Label</key>              <string>@BUNDLE_ID@.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/FreeRDP-Shadow.app/Contents/MacOS/freerdp-shadow-cli</string>
        <string>/bind-address:127.0.0.1</string>
        <string>/port:3388</string>
        <!-- TLS security: the login is the Mac's own (PAM); with NLA the server would
             check a SAM file instead (-sec-nla does not turn that off) -->
        <string>/sec:tls</string>
        <string>/gfx-av1</string>
        <string>/gfx-av2</string>
        <!-- H.264 as AVC420: AVC444 sent 15-18 times the bytes for the same screen
             (as in @BUNDLE_ID@.plist) -->
        <string>-gfx-avc444</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- the daemon mode: the agents connect to this Mach service -->
        <key>FREERDP_SHADOW_MAC_AGENT_SERVICE</key> <string>@BUNDLE_ID@</string>
        <!-- launchd gives a daemon no HOME; without one the server cannot make a client's
             context (ContextNew fails) and an assert ends it -->
        <key>HOME</key>           <string>/var/root</string>
    </dict>
    <key>MachServices</key>
    <dict>
        <key>@BUNDLE_ID@</key> <true/>
    </dict>
    <key>RunAtLoad</key>          <true/>
    <key>KeepAlive</key>          <true/>
    <!-- at most one start every 10 s if it keeps ending (launchd's default, said out loud) -->
    <key>ThrottleInterval</key>   <integer>10</integer>
    <!-- one log, appended to by every start (install-daemon.sh makes the folder) -->
    <key>StandardOutPath</key>    <string>/var/log/freerdp-shadow/daemon.log</string>
    <key>StandardErrorPath</key>  <string>/var/log/freerdp-shadow/daemon.log</string>
</dict>
</plist>
