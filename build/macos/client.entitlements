<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FreeRDP.app's sdl-freerdp under the hardened runtime: the camera (MS-RDPECAM) and the
     microphone (/microphone: the remote session's audio input) are resources the runtime
     refuses without their entitlement. Neither needs a provisioning profile (hardened
     runtime resource access entitlements). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
