#!/bin/sh
# The demo's page in Firefox: web video with sound next to WebGL, served from
# the server's own 127.0.0.1 (media from demo-assets.sh, mounted at /demo)
mkdir -p /tmp/webdemo /tmp/ff-demo
ln -sf /demo-setup/media.html /tmp/webdemo/index.html
ln -sf /demo/bunny.webm /tmp/webdemo/bunny.webm
ln -sfn /demo/webgl /tmp/webdemo/webgl
cp /demo-setup/user.js /tmp/ff-demo/
setsid -f python3 -m http.server 8000 --bind 127.0.0.1 --directory /tmp/webdemo > /dev/null 2>&1
sleep 1
exec setsid -f firefox-esr --no-remote --profile /tmp/ff-demo --width 1720 --height 900 \
    http://127.0.0.1:8000/ > /tmp/firefox.log 2>&1
