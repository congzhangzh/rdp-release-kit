# Distributions to build xrdp packages for, as container images: the
# testing, stable and oldstable release of each.
# Ubuntu: the latest release and the two newest LTS (25.10 is out of
# support). Fedora: the next release (prerelease until late October 2026)
# and the two supported ones. RHEL 10 and its rebuilds no longer ship the
# Xorg server, which xorgxrdp needs.
debian:testing
debian:13
debian:12
ubuntu:26.10
ubuntu:26.04
ubuntu:24.04
fedora:45
fedora:44
fedora:43
